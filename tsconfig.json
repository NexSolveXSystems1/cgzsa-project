{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    /* typescript-eslint does not yet support TypeScript 7, so there is no
       TS-aware ESLint for this toolchain. These compiler checks cover the
       defects a linter would have caught in this codebase: an unused import in
       the authentication module, and unused locals left behind by refactors.
       They run in CI through `npm run typecheck`. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/app/*": [
        "./cgzsa-frontend/src/app/*"
      ],
      "@/components/*": [
        "./cgzsa-frontend/src/components/*"
      ],
      "@/actions/*": [
        "./cgzsa-backend/src/actions/*"
      ],
      "@/api/*": [
        "./cgzsa-backend/src/api/*"
      ],
      "@/db": [
        "./cgzsa-backend/src/db/index.ts"
      ],
      "@/db/*": [
        "./cgzsa-backend/src/db/*"
      ],
      "@/lib/*": [
        "./cgzsa-backend/src/lib/*"
      ],
      "@/*": [
        "./cgzsa-frontend/src/*",
        "./cgzsa-backend/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "cgzsa-frontend/next-env.d.ts",
    "cgzsa-frontend/**/*.ts",
    "cgzsa-frontend/**/*.tsx",
    "cgzsa-backend/**/*.ts",
    "cgzsa-backend/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "*.ts",
    "*.tsx",
    "cgzsa-frontend/.next/types/**/*.ts",
    "cgzsa-frontend/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
