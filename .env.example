# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 16 or later.
DATABASE_URL="postgresql://cgzsa:change-me@localhost:5432/cgzsa"

# ── Application ─────────────────────────────────────────────────────────────
# The public address of the site. Used for canonical URLs and Open Graph tags.
APP_URL="https://cgzsa.org"

# Note: there is no SESSION_SECRET. Sessions are opaque random tokens stored
# hashed in the database, so there is nothing for a secret to sign. The variable
# used to be documented here and required by the README while being read by no
# code, which gave false assurance that session security depended on setting it.

# Password given to the seeded accounts. Change it, and change it again in the
# application after the first sign-in.
SEED_ADMIN_PASSWORD=""

# ── The assistant ───────────────────────────────────────────────────────────
# stub      answers extractively from your own indexed content. 100% FREE ($0 cost), no network required.
# groq      free cloud LLM provider via Groq API (requires ASSISTANT_API_KEY).
# ollama    free local offline LLM provider (requires local Ollama server).
# anthropic hosted Anthropic Claude API (requires ASSISTANT_API_KEY).
ASSISTANT_PROVIDER="stub"
ASSISTANT_API_KEY=""
ASSISTANT_MODEL="extractive"
ASSISTANT_BASE_URL=""

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Protects /api/cron, which publishes scheduled articles and deletes records
# past their retention date. Required in production; the endpoint refuses to
# run without it. Generate with:  openssl rand -hex 32
CRON_SECRET=""

# ── Email ───────────────────────────────────────────────────────────────────
# Contact messages and volunteer applications are stored first and emailed
# second, so a mail outage never loses one. Leave blank to store only — the form
# still works and the message is still recorded, but nobody is notified, so set
# this before launch. Password resets and invitations also need it: without SMTP
# an invited user cannot receive their link.
SMTP_URL=""
SMTP_FROM="CGZSA website <no-reply@cgzsa.org>"

# ── File storage ────────────────────────────────────────────────────────────
# Uploads can be written to the local disk (STORAGE_DRIVER="local") or to an
# S3-compatible cloud storage bucket (STORAGE_DRIVER="s3").
#
# **Netlify / Vercel Deployments**: You MUST use "s3" because serverless environments
# do not have persistent local disks. Local uploads will disappear. You can use
# AWS S3, Cloudflare R2, Supabase Storage, or DigitalOcean Spaces.
STORAGE_DRIVER="local"

# Local Storage Path (only used if STORAGE_DRIVER="local")
STORAGE_PATH="./storage"

# S3 Configuration (only used if STORAGE_DRIVER="s3")
S3_ENDPOINT="https://<your-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="cgzsa-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── Proxying ────────────────────────────────────────────────────────────────
# How many reverse proxies sit in front of the application. Rate limits and the
# audit log read the client address from the trusted end of X-Forwarded-For, and
# this is how far in to count.
#
#   0   nothing in front of the app (the header is ignored entirely)
#   1   one reverse proxy: nginx, Caddy, a single load balancer  [default]
#   2   a CDN in front of a reverse proxy
#
# Set this to the real number. Too high and a client can forge its own address;
# too low and every visitor shares one rate-limit bucket.
TRUSTED_PROXY_COUNT="1"

# Better still, if your platform sets a header clients cannot forge, name it
# here and it takes precedence (cf-connecting-ip, true-client-ip, fly-client-ip).
CLIENT_IP_HEADER=""
